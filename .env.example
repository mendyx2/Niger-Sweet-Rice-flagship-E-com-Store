# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://nsr:nsr@localhost:5432/nsr?schema=public"

# Public site URL (used for canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Staff access to /ops (temporary until phone-OTP staff accounts land in Phase 2).
# OPS_PASSWORD: long random passphrase shared only with staff.
# SESSION_SECRET: 32+ random bytes, e.g. `openssl rand -base64 48`
OPS_PASSWORD=""
SESSION_SECRET=""

# Brand name shown across the site
NEXT_PUBLIC_BRAND_NAME="Naija Sweet Rice"

# Flagship store details (shown in footer, contact page and Google structured data)
NEXT_PUBLIC_STORE_PHONE="+234 800 000 0000"
NEXT_PUBLIC_STORE_WHATSAPP="2348000000000"
NEXT_PUBLIC_STORE_STREET="Flagship store street address"
NEXT_PUBLIC_STORE_AREA="Wuse II"
NEXT_PUBLIC_STORE_LAT=""
NEXT_PUBLIC_STORE_LNG=""


# Termii SMS for login codes and order updates. Without a key, dev prints SMS to the console.
TERMII_API_KEY=""
TERMII_SENDER_ID=""

# Protects /api/cron/release-reservations (call every 5–10 minutes).
CRON_SECRET=""

# Analytics (load only after the visitor accepts cookies). Leave empty to disable.
NEXT_PUBLIC_GA_ID=""          # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""  # digits only

# Optional shared rate limiting (Upstash Redis REST). Needed when running more than one server.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# Google "stock depletion" sheet (optional). Create a Google Cloud service account with the Sheets API
# enabled, share the sheet with its email as Editor, and paste the JSON key's private_key below.
GOOGLE_SHEETS_ID=""                 # from the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_KEY=""       # "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Staff alerts (free): Telegram bot from @BotFather, plus a random secret Telegram must send back.
# After the site is live: /ops/distributors → "Connect bot to site". Without a token, dev prints alerts to the console.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""          # e.g. `openssl rand -hex 24`

# Staff alert emails via Resend (free tier). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM=""                       # e.g. "Naija Sweet Rice <alerts@yourdomain.ng>"
OPS_ALERT_EMAIL=""                  # where HQ alerts are emailed
